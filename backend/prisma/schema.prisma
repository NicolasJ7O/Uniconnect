generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  avatarUrl       String?
  role            String   @default("student")
  isActive        Boolean  @default(true)
  career          String?
  currentSemester Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identities     AuthIdentity[]
  sessions       Session[]
  subjects       Subject[]            @relation("StudentSubjects")
  ownedGroups    StudyGroup[]         @relation("GroupOwner")
  memberOfGroups StudyGroup[]         @relation("GroupMembers")
  uploadedResources StudyGroupResource[]
  eventSubscriptions EventSubscription[] @relation("EventSubscriptions")
  posts           Post[]              @relation("UserPosts")
  comments        Comment[]           @relation("UserComments")
  organizedEvents Event[]             @relation("OrganizedEvents")
  groupRequests   StudyGroupRequest[] @relation("UserGroupRequests")
  notifications   Notification[]      @relation("UserNotifications")
  transfersSent   OwnershipTransferRequest[] @relation("TransfersSent")
  transfersReceived OwnershipTransferRequest[] @relation("TransfersReceived")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  credits   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students User[] @relation("StudentSubjects")
  studyGroups StudyGroup[] @relation("SubjectGroups")
}

model AuthIdentity {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerUserId  String
  emailAtProvider String
  hostedDomain    String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "provider_providerUserId")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  subjectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User                 @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subject   Subject?             @relation("SubjectGroups", fields: [subjectId], references: [id], onDelete: Cascade)
  members   User[]               @relation("GroupMembers")
  resources StudyGroupResource[]
  requests StudyGroupRequest[] @relation("GroupRequests")
  posts    Post[]              @relation("GroupPosts")
  ownershipTransfers OwnershipTransferRequest[]
  messages Message[]           @relation("GroupMessages")
}

model StudyGroupResource {
  id         String   @id @default(cuid())
  groupId    String
  uploaderId String?
  title      String
  type       String   // "PDF" or "LINK"
  url        String
  createdAt  DateTime @default(now())

  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader User?      @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
}

model Post {
  id        String   @id @default(cuid())
  title     String?
  type      String   @default("GENERAL")
  isPinned  Boolean  @default(false)
  content   String
  authorId  String
  groupId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  group     StudyGroup @relation("GroupPosts", fields: [groupId], references: [id], onDelete: Cascade)
  comments  Comment[]
  resources Resource[]
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String
  postId    String?
  createdAt DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  eventDate   DateTime
  location    String?
  category    String   @default("OTRO") // ACADEMICO, CULTURAL, DEPORTIVO, TECNOLOGIA, OTRO
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer User @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
}

model EventSubscription {
  id        String   @id @default(cuid())
  userId    String
  category  String
  createdAt DateTime @default(now())

  user User @relation("EventSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model StudyGroupRequest {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group StudyGroup @relation("GroupRequests", fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation("UserGroupRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  metadata  Json?

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model OwnershipTransferRequest {
  id        String   @id @default(cuid())
  groupId   String
  fromId    String
  toId      String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  User       @relation("TransfersSent", fields: [fromId], references: [id], onDelete: Cascade)
  to    User       @relation("TransfersReceived", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([groupId, toId]) // Only one pending transfer per user per group
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  groupId    String?
  receiverId String?
  isPrivate  Boolean  @default(false)
  fileUrl    String?
  fileName   String?
  fileType   String?
  createdAt  DateTime @default(now())

  sender    User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User?       @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group     StudyGroup? @relation("GroupMessages", fields: [groupId], references: [id], onDelete: Cascade)
}
