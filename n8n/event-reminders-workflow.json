    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO n8n_executions (id, \"workflowName\", \"startedAt\", \"finishedAt\", \"totalSent\", \"totalFailed\", \"durationMs\", status, \"createdAt\") VALUES (gen_random_uuid(), 'HU-N8N01: Recordatorios de Eventos', NOW(), NOW(), (SELECT COUNT(*) FROM event_reminder_logs WHERE status = 'success' AND \"sentAt\" >= NOW() - INTERVAL '1 hour'), (SELECT COUNT(*) FROM event_reminder_logs WHERE status = 'failed' AND \"sentAt\" >= NOW() - INTERVAL '1 hour'), 0, 'success', NOW());",
        "options": {}
      },
      "id": "7809787e-e5d3-45ab-8c9e-52b3149a62f4",
      "name": "Postgres: Log Ejecución",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
