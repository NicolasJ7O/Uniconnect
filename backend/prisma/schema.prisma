generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  avatarUrl       String?
  role            String   @default("student")
  isActive        Boolean  @default(true)
  career          String?
  currentSemester Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identities     AuthIdentity[]
  sessions       Session[]
  subjects       Subject[]            @relation("StudentSubjects")
  ownedGroups    StudyGroup[]         @relation("GroupOwner")
  memberOfGroups StudyGroup[]         @relation("GroupMembers")
  uploadedResources StudyGroupResource[]
  eventSubscriptions EventSubscription[] @relation("EventSubscriptions")
  posts           Post[]              @relation("UserPosts")
  comments        Comment[]           @relation("UserComments")
  organizedEvents Event[]             @relation("OrganizedEvents")
  groupRequests   StudyGroupRequest[] @relation("UserGroupRequests")
  notifications   Notification[]      @relation("UserNotifications")
  transfersSent   OwnershipTransferRequest[] @relation("TransfersSent")
  transfersReceived OwnershipTransferRequest[] @relation("TransfersReceived")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  pollsCreated      Poll[] @relation("PollsCreated")
  pollVotesCast     PollVote[] @relation("PollVotesCast")
  assistantSessions AssistantSession[] @relation("UserAssistantSessions")

  forumQuestions  ForumQuestion[]     @relation("UserForumQuestions")
  forumAnswers    ForumAnswer[]       @relation("UserForumAnswers")
  questionVotes   ForumQuestionVote[] @relation("UserQuestionVotes")
  answerVotes     ForumAnswerVote[]   @relation("UserAnswerVotes")
  forumLogs       ForumAuditLog[]     @relation("UserForumLogs")

  academicResources AcademicResource[] @relation("UserAcademicResources")
  resourceAuditLogs ResourceAuditLog[] @relation("UserResourceLogs")
  studySessionsCreated SesionEstudioBase[] @relation("StudySessionCreator")
  studySessionSeriesCreated SesionEstudioSerie[] @relation("StudySessionSeriesCreator")
  studySessionParticipants SesionEstudioParticipante[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  credits   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students User[] @relation("StudentSubjects")
  studyGroups StudyGroup[] @relation("SubjectGroups")

  forumQuestions    ForumQuestion[]
  forumLogs         ForumAuditLog[]      @relation("SubjectForumLogs")

  academicResources AcademicResource[]   @relation("SubjectAcademicResources")
  resourceAuditLogs ResourceAuditLog[]   @relation("SubjectResourceLogs")
  studySessions SesionEstudioBase[]      @relation("StudySessionSubject")
  studySessionSeries SesionEstudioSerie[] @relation("StudySessionSeriesSubject")
}

model AuthIdentity {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerUserId  String
  emailAtProvider String
  hostedDomain    String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "provider_providerUserId")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  subjectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User                 @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subject   Subject?             @relation("SubjectGroups", fields: [subjectId], references: [id], onDelete: Cascade)
  members   User[]               @relation("GroupMembers")
  resources StudyGroupResource[]
  requests StudyGroupRequest[] @relation("GroupRequests")
  posts    Post[]              @relation("GroupPosts")
  ownershipTransfers OwnershipTransferRequest[]
  messages Message[]           @relation("GroupMessages")
  polls    Poll[]
}

model StudyGroupResource {
  id         String   @id @default(cuid())
  groupId    String
  uploaderId String?
  title      String
  type       String   // "PDF" or "LINK"
  url        String
  createdAt  DateTime @default(now())

  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader User?      @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
}

model Post {
  id        String   @id @default(cuid())
  title     String?
  type      String   @default("GENERAL")
  isPinned  Boolean  @default(false)
  content   String
  authorId  String
  groupId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  group     StudyGroup @relation("GroupPosts", fields: [groupId], references: [id], onDelete: Cascade)
  comments  Comment[]
  resources Resource[]
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String
  postId    String?
  createdAt DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  eventDate   DateTime
  location    String?
  category    String   @default("OTRO") // ACADEMICO, CULTURAL, DEPORTIVO, TECNOLOGIA, OTRO
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer User @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
}

model EventSubscription {
  id        String   @id @default(cuid())
  userId    String
  category  String
  createdAt DateTime @default(now())

  user User @relation("EventSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model AssistantSession {
  id          String   @id @default(cuid())
  userId      String
  sessionKey  String
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastSeenAt  DateTime @default(now())

  user     User               @relation("UserAssistantSessions", fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@unique([userId, sessionKey])
  @@index([userId, role, lastSeenAt])
}

model AssistantMessage {
  id          String   @id @default(cuid())
  sessionId   String
  speakerRole String
  content     String
  metadata    Json?
  createdAt   DateTime @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model StudyGroupRequest {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group StudyGroup @relation("GroupRequests", fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation("UserGroupRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  metadata  Json?

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model OwnershipTransferRequest {
  id        String   @id @default(cuid())
  groupId   String
  fromId    String
  toId      String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  User       @relation("TransfersSent", fields: [fromId], references: [id], onDelete: Cascade)
  to    User       @relation("TransfersReceived", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([groupId, toId]) // Only one pending transfer per user per group
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  groupId    String?
  receiverId String?
  isPrivate  Boolean  @default(false)
  fileUrl    String?
  fileName   String?
  fileType   String?
  createdAt  DateTime @default(now())

  sender    User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User?       @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group     StudyGroup? @relation("GroupMessages", fields: [groupId], references: [id], onDelete: Cascade)
  poll      Poll?
}

enum PollStatus {
  ACTIVE
  CLOSED
}

model Poll {
  id              String     @id @default(cuid())
  messageId       String     @unique
  groupId         String
  creatorId       String
  question        String
  allowMultiple   Boolean    @default(false)
  maxSelections   Int        @default(1)
  closingAt       DateTime?
  closedAt        DateTime?
  status          PollStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  message Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  group   StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User        @relation("PollsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([groupId, status, closingAt])
}

model PollOption {
  id        String   @id @default(cuid())
  pollId    String
  label     String
  position  Int
  createdAt DateTime @default(now())

  poll  Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, position])
  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("PollVotesCast", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId, userId])
  @@index([optionId])
}

model ForumQuestion {
  id        String   @id @default(cuid())
  title     String
  content   String
  subjectId String
  authorId  String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author    User                @relation("UserForumQuestions", fields: [authorId], references: [id], onDelete: Cascade)
  answers   ForumAnswer[]
  votes     ForumQuestionVote[]
}

model ForumAnswer {
  id         String   @id @default(cuid())
  content    String
  questionId String
  authorId   String
  isAccepted Boolean  @default(false)
  score      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question ForumQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User              @relation("UserForumAnswers", fields: [authorId], references: [id], onDelete: Cascade)
  votes    ForumAnswerVote[]
}

model ForumQuestionVote {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  value      Int      // 1 or -1
  createdAt  DateTime @default(now())

  user     User          @relation("UserQuestionVotes", fields: [userId], references: [id], onDelete: Cascade)
  question ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model ForumAnswerVote {
  id        String   @id @default(cuid())
  userId    String
  answerId  String
  value     Int      // 1 or -1
  createdAt DateTime @default(now())

  user   User        @relation("UserAnswerVotes", fields: [userId], references: [id], onDelete: Cascade)
  answer ForumAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
}

model ForumAuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // CREATE_QUESTION, UPDATE_QUESTION, CREATE_ANSWER, VOTE_QUESTION, VOTE_ANSWER, ACCEPT_ANSWER
  subjectId  String
  targetId   String   // ID of question or answer
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User          @relation("UserForumLogs", fields: [userId], references: [id], onDelete: Cascade)
  subject    Subject       @relation("SubjectForumLogs", fields: [subjectId], references: [id], onDelete: Cascade)
}

// ============================================================
// BIBLIOTECA COLABORATIVA DE RECURSOS ACADÉMICOS
// ============================================================

model AcademicResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String?
  type        String   @default("LINK") // LINK | PDF | VIDEO | DOCUMENTO | OTRO
  authorId    String
  subjectId   String
  isDeleted   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User              @relation("UserAcademicResources", fields: [authorId], references: [id], onDelete: Cascade)
  subject   Subject           @relation("SubjectAcademicResources", fields: [subjectId], references: [id], onDelete: Cascade)
  openGraph ResourceOpenGraph?
  tags      ResourceTagMap[]
  stats     ResourceStats?
  auditLogs ResourceAuditLog[]
}

model ResourceOpenGraph {
  id          String   @id @default(cuid())
  resourceId  String   @unique
  ogTitle     String?
  ogDescription String?
  ogImage     String?
  ogSiteName  String?
  fetchedAt   DateTime @default(now())

  resource AcademicResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model ResourceTag {
  id    String           @id @default(cuid())
  name  String           @unique
  maps  ResourceTagMap[]
}

model ResourceTagMap {
  resourceId String
  tagId      String

  resource AcademicResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      ResourceTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
}

model ResourceStats {
  id          String   @id @default(cuid())
  resourceId  String   @unique
  views       Int      @default(0)
  downloads   Int      @default(0)
  votes       Int      @default(0)
  updatedAt   DateTime @updatedAt

  resource AcademicResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model ResourceAuditLog {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  subjectId  String
  action     String   // CREATE | UPDATE | DELETE | VOTE
  metadata   Json?
  createdAt  DateTime @default(now())

  resource AcademicResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User             @relation("UserResourceLogs", fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject          @relation("SubjectResourceLogs", fields: [subjectId], references: [id], onDelete: Cascade)
}

enum FrecuenciaSesionEstudio {
  DAILY
  WEEKLY
  MONTHLY
  INTERVAL
}

enum EstadoSesionEstudio {
  SCHEDULED
  CANCELED
  COMPLETED
}

enum CanalRecordatorioSesion {
  DATABASE
  WEBSOCKET
}

model SesionEstudioSerie {
  id               String   @id @default(cuid())
  title            String
  description      String?
  subjectId        String
  creatorId        String
  baseStartAt      DateTime
  durationMinutes  Int
  recurrenceConfig Json
  reminderMinutes  Json?
  status           EstadoSesionEstudio @default(SCHEDULED)
  canceledAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subject   Subject             @relation("StudySessionSeriesSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  creator   User                @relation("StudySessionSeriesCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  sessions  SesionEstudioBase[]

  @@index([creatorId, baseStartAt])
  @@index([subjectId, baseStartAt])
}

model SesionEstudioBase {
  id                 String   @id @default(cuid())
  seriesId           String?
  title              String
  description        String?
  subjectId          String
  creatorId          String
  startAt            DateTime
  endAt              DateTime
  durationMinutes    Int
  occurrenceIndex    Int      @default(0)
  status             EstadoSesionEstudio @default(SCHEDULED)
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  series      SesionEstudioSerie?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  subject     Subject                    @relation("StudySessionSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  creator     User                       @relation("StudySessionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants SesionEstudioParticipante[]
  reminders    SesionEstudioRecordatorio[]

  @@unique([seriesId, startAt])
  @@index([creatorId, startAt])
  @@index([seriesId, startAt])
  @@index([subjectId, startAt])
  @@index([status, startAt])
}

model SesionEstudioParticipante {
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session SesionEstudioBase @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
}

model SesionEstudioRecordatorio {
  id             String   @id @default(cuid())
  sessionId      String
  minutesBefore  Int
  scheduledAt    DateTime
  sentAt         DateTime?
  channel        CanalRecordatorioSesion @default(DATABASE)
  notificationId String?
  createdAt      DateTime @default(now())

  session SesionEstudioBase @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, minutesBefore])
  @@index([scheduledAt, sentAt])
}
