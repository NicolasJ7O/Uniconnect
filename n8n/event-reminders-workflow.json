    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO event_reminder_logs (id, \"eventoId\", \"userId\", email, status, \"errorMessage\", \"sentAt\") VALUES (gen_random_uuid(), '{{ $node[\"Split In Batches\"].json[\"eventoId\"] }}', '{{ $node[\"Split In Batches\"].json[\"userId\"] }}', '{{ $node[\"Split In Batches\"].json[\"email\"] }}', 'success', NULL, NOW());",
        "options": {}
      },
      "id": "c71d6f1a-b684-469b-8f3a-c85244519965",
      "name": "Postgres: Log Exitoso",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1320,
